+def _single_cell_difference(first, second):
+    before, after = _full_table_layout(first), _full_table_layout(second)
+    if len(before) != len(after):
+        return False
+    differences = 0
+    for left, right in zip(before, after):
+        if left[:-1] != right[:-1]:
+            return False
+        if left[0] == 'text':
+            if left != right:
+                return False
+            continue
+        if len(left[-1]) != len(right[-1]):
+            return False
+        for row, other in zip(left[-1], right[-1]):
+            if len(row) != len(other):
+                return False
+            differences += sum(x != y for x, y in zip(row, other))
+    return differences == 1
+
+
+def verify_table_pair(paths, source_sha, root, *, independent_read):
+    """Break a one-cell tie only with an independent, matching full table."""
+    try:
+        return from_receipts(paths, source_sha, root)
+    except ValueError as error:
+        if str(error) != 'full-table-reads-disagree':
+            raise
+    records = [json.loads(Path(path).read_text()) for path in paths]
+    if not _single_cell_difference(*(record['response'] for record in records)):
+        return None
+    # A fixed blind prompt reuses the subscription inference cache on retries.
+    review = independent_read()
+    if not review.get('ok') or not review.get('read_receipt'):
+        return None
+    for original in paths:
+        try:
+            result = from_receipts([original, review['read_receipt']], source_sha, root)
+        except ValueError:
+            continue
+        if result.get('projection', {}).get('kind') == 'full-table':
+            return result
+    return None
