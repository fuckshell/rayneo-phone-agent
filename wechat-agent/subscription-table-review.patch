@@ -0,0 +1,59 @@
+import copy
+import hashlib
+import json
+from pathlib import Path
+import tempfile
+import unittest
+from unittest.mock import Mock, patch
+
+import vision_pipeline as vision
+from scoped_table_consensus import verify_table_pair
+
+
+class TableReviewTests(unittest.TestCase):
+    def setUp(self):
+        self.folder = Path(self.enterContext(tempfile.TemporaryDirectory()))
+        self.image = self.folder / 'test.png'
+        self.image.write_bytes(b'test source')
+        self.sha = hashlib.sha256(self.image.read_bytes()).hexdigest()
+        self.first = {'blocks': [{'text': 'Sample', 'rows': [], 'header_depth': 0},
+                        {'text': '', 'header_depth': 1, 'rows': [['Name', 'Value'], ['A', '42']]}]}
+        self.second = copy.deepcopy(self.first)
+        self.second['blocks'][1]['rows'][1][1] = '43'
+
+    def receipt(self, name, response, sha=None):
+        path = self.folder / (name + '.json')
+        path.write_text(json.dumps({'source_sha256': sha or self.sha,
+            'prompt_sha256': hashlib.sha256(name.encode()).hexdigest(),
+            'provider':'antigravity-subscription','model':'gemini-3.8-flash-medium',
+            'response':response}))
+        return path
+
+    def check(self, third):
+        first = self.receipt('first', self.first)
+        second = self.receipt('second', self.second)
+        return verify_table_pair([first, second], self.sha, self.folder, independent_read=third)
+
+    def test_accepted_only_if_independent_full_read_agrees(self):
+        for response in (self.first, self.second):
+            third = Mock(return_value={'ok':True, 'read_receipt': self.receipt('third', response)})
+            self.assertEqual(self.check(third)['answer'], vision._table_blocks_answer(response))
+            third.assert_called_once_with()
+        other = copy.deepcopy(self.second)
+        other['blocks'][1]['rows'][1][1] = '44'
+        self.assertIsNone(self.check(lambda: {'ok':True,'read_receipt':self.receipt('third', other)}))
+        self.assertIsNone(self.check(lambda: {'ok':True,'read_receipt':self.receipt('third', self.first, 'f'*64)}))
+
+    def test_prose_or_shape_changes_require_normal_recovery(self):
+        third = Mock(side_effect=AssertionError('unexpected third read'))
+        self.second['blocks'][0]['text'] = 'Different'
+        self.assertIsNone(self.check(third))
+        self.second['blocks'][0]['text'] = 'Sample'
+        self.second['blocks'][1]['rows'].append(['B', '1'])
+        self.assertIsNone(self.check(third))
+
+    def test_subscription_only_review_has_no_paid_fallback(self):
+        import inference
+        with patch.object(vision, 'subscription_infer', side_effect=AssertionError('unexpected fallback')), \
+             patch.object(inference, 'infer', side_effect=inference.InferenceUnavailable('offline')):
+            self.assertFalse(vision._structured_table_read(self.image, 'read', subscription_only=True)['ok'])
