diff --git a/vision_calendar_bridge.py b/vision_calendar_bridge.py
--- a/vision_calendar_bridge.py
+++ b/vision_calendar_bridge.py
@@ -585,6 +585,34 @@ def completed_flash_result(row: dict) -> bool:
 
 def get_schedule_vision_text(path: Path, sha: str, row: dict, *, allow_run: bool = False) -> str:
     """Read shared schedule_ocr cache only; vision runs in distill_media.ensure_schedule_ocr."""
+    # A completed upstream decision closes calendar screening, not a future
+    # user request for detail. Do this before the OCR cache and inference lock.
+    from image_retry import cached_coarse_screening, is_requested
+    from image_store import is_flash_record
+    from vision_pipeline import verified_coarse_source, is_interactive_vision_ready
+    if (sha and sha == row.get("file_sha") and not is_requested(row)
+            and verified_coarse_source(row, path)):
+        thumb = row.get("thumbnail_sha256") or sha
+        middle = (row.get("captured_tier") == "middle" and row.get("middle_sha256") == sha
+                  and is_interactive_vision_ready(row, path))
+        receipt = cached_coarse_screening(thumb) if thumb == sha or middle else {}
+        if (receipt.get("ok") is True and is_flash_record(receipt)
+                and receipt.get("screening_decision") == "summary_complete"
+                and receipt.get("screening_relevance") == "irrelevant"
+                and isinstance(receipt.get("evidence"), list) and receipt["evidence"]
+                and all(isinstance(s, str) and s.strip() for s in receipt["evidence"])
+                and str(receipt.get("screening_reason") or "").strip()):
+            locator = native_middle_source(row, (Path.home() / "key_ctrler"))
+            row["_calendar_triage"] = {
+                "relevance": "irrelevant", "reason": "upstream-screening-complete",
+                "summary": receipt.get("answer") or receipt.get("summary") or "",
+                "provider": receipt["provider"], "model": receipt["model"],
+                "evidence": receipt["evidence"], "screening_reason": receipt["screening_reason"],
+                "source": {"message_key": row.get("message_key") or row.get("id"),
+                           "thumbnail_sha256": thumb, "middle_path": str(path) if middle else None,
+                           "middle_cache_locator": str(locator) if locator else None},
+            }
+            return ""
     cached = get_schedule_ocr(sha) or migrate_legacy_schedule_ocr(sha)
     if cached and not is_weak_summary(cached) and "无法帮助" not in cached:
         return cached.strip()
