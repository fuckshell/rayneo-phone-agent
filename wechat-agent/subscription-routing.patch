+"""Resolve a denied calendar run against an operator-selected live event and task.
+
+Preparation runs subscription-only inference. Verification re-reads the same
+remote records and accepts only the exact previously generated inference result.
+"""
+import hashlib
+import json
+from pathlib import Path
+
+from calendar_tool import load_state, query_live_events
+from feishu_lib import get_access_token, get_task, feishu_due_to_local
+
+ROOT = Path(__file__).resolve().parents[2]
+
+
+def evidence(job, event_uid, todo_uid):
+    from validate_calendar_final_receipt import _embedded_task_payload, verify_identity
+    failed = job['result']['vision_calendar']['result']
+    if failed.get('detail') != 'calendar-antigravity-permission-denied-outcome-unknown':
+        raise ValueError('unsupported-failure')
+    task_id = 'calendar:' + failed['session_key'].rsplit(':', 1)[0]
+    folder = ROOT / 'handoffs/antigravity' / hashlib.sha256(task_id.encode()).hexdigest()
+    task = json.loads((folder / 'task.json').read_text())
+    if task['task_id'] != task_id:
+        raise ValueError('handoff-task-mismatch')
+    message = _embedded_task_payload(task['prompt'])['evidence']['message']
+    verify_identity(job['event'], message, failed)
+    state = load_state()
+    events = query_live_events(state, uid_filter=event_uid, compact=True)
+    matches = [e for e in events if e.get('uid') == event_uid and e.get('remote_verified') is True]
+    if len(matches) != 1:
+        raise ValueError('live-event-not-unique')
+    event = {k: matches[0].get(k) for k in ('uid','event_id','title','start_time','end_time','location','recurrence')}
+    local = state['todo_items'][todo_uid]
+    guid = state['feishu_sync']['tasks'][todo_uid]
+    token, _ = get_access_token(prefer_user=True)
+    response = get_task(token, guid)
+    remote = response.get('data', {}).get('task') or {}
+    due = feishu_due_to_local(remote)
+    if (response.get('code') != 0 or remote.get('guid') != guid or remote.get('summary') != local['title']
+            or due != local['due_date'] or not remote.get('completed_at')
+            or (str(remote['completed_at']) != '0') != bool(local.get('completed_at'))):
+        raise ValueError('live-todo-mismatch')
+    todo = dict(uid=todo_uid, task_guid=guid, title=local['title'], due_date=due, completed_at=remote['completed_at'])
+    payload = dict(message=message, current_event=event, current_todo=todo)
+    prompt = ('只读核验：从原消息和上下文逐项判断，列出的飞书日程和待办是否已满足这条消息的全部要求。'
+              '时间地点、适用人员、登记要求或其他动作有缺失或变化时返回 needs-review。'
+              '不执行任何工具，不写入。若全部覆盖返回 status=noop、event_uid、todo_uid、reason；否则返回 status=needs-review 和原因。\n'
+              + json.dumps(payload, ensure_ascii=False, sort_keys=True))
+    return prompt, event, todo
+
+
+def decision(job, event_uid, todo_uid, *, prepare=False):
+    import inference
+    prompt, event, todo = evidence(job, event_uid, todo_uid)
+    store = ROOT / 'state/antigravity-screen'
+    # Use the inference module's actual cache identity. Verification never
+    # reserves a worker or starts a model while ingest holds a repair snapshot.
+    value = inference.infer(prompt) if prepare else None
+    cache = inference.inference_cache_path(store, prompt, None, inference.flash_model())
+    digest = cache.stem
+    cached = json.loads(cache.read_text())
+    if (prepare and cached != value or cached.get('status') != 'noop' or not cached.get('reason')
+            or cached.get('event_uid') != event_uid or cached.get('todo_uid') != todo_uid):
+        raise ValueError('subscription-did-not-confirm-arrangement')
+    return dict(status='noop', reason=cached['reason'], receipts=[], coverage={'required':False},
+                verified_event=event, todo_result={**todo,'ok':True,'remote_verified':True},
+                inference_digest=digest, provider=inference.PROVIDER)
