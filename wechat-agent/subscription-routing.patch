+"""Billing routing regressions with isolated stores and no network calls."""
+from contextlib import ExitStack
+import fcntl
+import json
+import os
+from pathlib import Path
+import tempfile
+import unittest
+from unittest.mock import Mock, patch
+
+import antigravity_calendar
+import antigravity_screen
+import context_calendar_pipeline as pipeline
+import inference
+import media_dispatch
+import provider_fallback
+import reconcile_existing_arrangement as arrangement
+
+
+class SubscriptionRoutingTests(unittest.TestCase):
+    def test_cli_failure_then_cooldown_then_quota_recheck(self):
+        for error in ('HTTP 429', 'invalid model selection: offline'):
+            with self.subTest(error=error), tempfile.TemporaryDirectory() as tmp, ExitStack() as stack:
+                child = Mock(returncode=1)
+                child.communicate.return_value = (json.dumps(dict(status='ERROR', error=error, num_turns=0)), '')
+                runner = stack.enter_context(patch.object(inference.subprocess, 'Popen', return_value=child))
+                helper = inference.helper_module()
+                helper.membership_quota = Mock(side_effect=[{'ok': True}, {'ok': False, 'error': 'membership-quota-exhausted'}])
+                stack.enter_context(patch.object(inference, 'helper_module', return_value=helper))
+                paid = stack.enter_context(patch('media_api_burst.call', return_value=({'answer':'fixture'}, 'gemini', 'flash')))
+                for _ in range(2):
+                    with self.assertRaises(inference.InferenceYield):
+                        provider_fallback.infer('fixture', store=tmp)
+                paid.assert_not_called()
+                runner.assert_called_once()
+                with patch('time.time', return_value=10**10):
+                    self.assertEqual(provider_fallback.infer('fixture', store=tmp)['answer'], 'fixture')
+                paid.assert_called_once()
+                self.assertEqual(helper.membership_quota.call_count, 2)
+
+    def test_screen_startup_and_short_throttle_yield_before_fallback(self):
+        for error in ('invalid model selection: offline', 'HTTP 429'):
+            with self.subTest(error=error), tempfile.TemporaryDirectory() as tmp, ExitStack() as stack:
+                child = Mock(returncode=1)
+                child.communicate.return_value = (json.dumps(dict(error=error, num_turns=0)), '')
+                runner = Mock(return_value=child)
+                request = {'format':{}, 'messages':[{'content':'fixture'}]}
+                stack.enter_context(patch.object(pipeline, 'screen_locally', side_effect=lambda _: antigravity_screen.screen(
+                    request, store=tmp, runner=runner, quota_check=lambda *a: {'ok':True})))
+                paid = stack.enter_context(patch('media_api_burst.call'))
+                for _ in range(2):
+                    with self.assertRaises(inference.InferenceYield):
+                        pipeline.screen_relevance({})
+                paid.assert_not_called()
+                runner.assert_called_once()
+
+    def test_occupied_lane_never_spends(self):
+        with tempfile.TemporaryDirectory() as tmp, patch.dict(os.environ, {'WECHAT_AGY_LOCK_TIMEOUT':'0'}):
+            root = Path(tmp) / 'shared-worker'
