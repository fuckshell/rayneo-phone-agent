+"""Serialize classification evidence without repeating identical message text."""
+import json
+
+
+def _screen_row(row):
+    if not isinstance(row, dict):
+        return row
+    content = row.get("content")
+    media = row.get("media_context")
+    if (isinstance(content, str) and len(content) >= 64 and isinstance(media, dict)
+            and media.get("summary") == content and "summary_ref" not in media):
+        media = dict(media)
+        del media["summary"]
+        media["summary_ref"] = "content"
+        row = {**row, "media_context": media}
+    return row
+
+
+def screen_json(bundle):
+    message = bundle.get("message")
+    if isinstance(message, dict):
+        rows = message.get("context")
+        for row in [message, *(rows if isinstance(rows, list) else [])]:
+            media = row.get("media_context") if isinstance(row, dict) else None
+            if isinstance(media, dict) and "summary_ref" in media:
+                return json.dumps(bundle, ensure_ascii=False)
+        message = _screen_row(message)
+        if isinstance(message.get("context"), list):
+            message = {**message, "context": [_screen_row(row) for row in message["context"]]}
+        bundle = {**bundle, "message": message}
+    return ("媒体字段 summary_ref 为 content 时，摘要逐字等于同一条消息的 content。\n"
+            + json.dumps(bundle, ensure_ascii=False, separators=(",", ":")))
