@@ -0,0 +1,29 @@
+"""An identical summary can be restored without changing evidence or row indices."""
+import copy
+import json
+import unittest
+
+from screening_payload import screen_json
+
+
+class ScreeningPayloadTest(unittest.TestCase):
+    def test_roundtrip_preserves_actor_order_originals_and_paths(self):
+        text = "逐字保留原件和换行\n" * 60
+        def row(author, summary):
+            return dict(sender=author, time="10:00", content=text,
+                        media_context=dict(summary=summary, file="synthetic.png"))
+        data = dict(message={**row("a", text), "context": [
+            row("b", text), row("c", text+"!"), row("d", ""), None]},
+            source={"id":1})
+        before = copy.deepcopy(data)
+        rendered = screen_json(data)
+        compact = json.loads(rendered.split("\n", 1)[1])
+        current = compact["message"]
+        self.assertEqual(current["media_context"]["summary_ref"], "content")
+        self.assertEqual(current["context"][0]["media_context"]["summary_ref"], "content")
+        for item in [current, *current["context"]]:
+            if item and item["media_context"].pop("summary_ref", None) == "content":
+                item["media_context"]["summary"] = item["content"]
+        self.assertEqual(before, compact)
+        self.assertEqual(before, data)
+        self.assertLess(len(rendered), len(json.dumps(data, ensure_ascii=False)))
